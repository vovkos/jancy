// semicolons and assignment precedence
//
// - a lambda body or a curly-initializer ends an initializer/assignment, so no ';'
//   is needed after the closing '}'
// - ';' is optional after expression statements, break, continue, assert
// - assignment has the lowest precedence (right-associative); the ternary operator
//   takes assignments in both branches, as in C++: c ? a : b = 5 is c ? a : (b = 5)

//..............................................................................

using namespace ns1
using namespace ns2;

namespace ns1 {
	int g_a = 1;
}

namespace ns2 {
	int g_b = 2;
}

int function* g_add(int) = [] int (int a) {
	return a + 3;
}

int usingNoSemicolon() {
	return g_a + g_b;
}

int function* g_mul(int) = [] int (int a) {
	return a * 10;
};

struct Point {
	int m_x;
	int m_y;
}

int foo(int a) {
	return a * 100;
}

//..............................................................................

void testDeclarators() {
	assert(g_add(1) == 4);
	assert(usingNoSemicolon() == 3);
	assert(g_mul(2) == 20);

	int function* f(int) = [] int (int a) {
		return a + 1;
	}

	int x = 2;
	int* p = &x;
	*p = 3; // must not glue to the lambda above

	assert(f(x) == 4);

	Point pt = { 1, 2 }
	assert(pt.m_x == 1 && pt.m_y == 2);
}

void testAssignments() {
	int function* f(int);
	int x = 0;
	int* p = &x;

	f = [] int (int a) {
		return a * 2;
	}
	*p = 5 // must not glue to the lambda above

	assert(f(x) == 10);

	f = [] int (int a) {
		return a * 3;
	};

	assert(f(x) == 15);

	bool c = true;
	f = c ? foo : [] int (int a) {
		return -a;
	}

	assert(f(2) == 200);

	f = !c ? foo : [] int (int a) {
		return -a;
	}

	assert(f(2) == -2);

	Point pt;
	pt = { 3, 4 }
	assert(pt.m_x == 3 && pt.m_y == 4);

	int sum = 0;
	multicast m(int);
	m += [] (int a) {
		sum += a;
	}

	m += [] (int a) {
		sum += a * 10;
	}

	m(2);
	assert(sum == 22);
}

void testIfElse() {
	int function* f(int);
	bool c = true;
	int x = 0;
	int y = 0;

	if (c) x = 1; else y = 1;
	assert(x == 1 && y == 0);

	if (!c) x = 2; else y = 2;
	assert(x == 1 && y == 2);

	if (c) f = [] int (int a) { return a * 3; }; else f = foo;
	assert(f(3) == 9);

	if (c) f = [] int (int a) { return a * 4; } else f = foo;
	assert(f(3) == 12);

	if (!c) f = [] int (int a) { return a * 4; } else f = foo;
	assert(f(3) == 300);
}

void testOptionalSemicolons() {
	int sum = 0;
	for (int i = 0; i < 10; i++) {
		if (i == 2)
			continue
		if (i == 5)
			break
		sum += i
	}

	assert(sum == 0 + 1 + 3 + 4)

	for (int i = 0; i < 3; i++)
		if (i == 1) break; else sum++;

	assert(sum == 9)
}

void testPrecedence() {
	int a = 1;
	int y = 2;
	bool c = true;

	int x;
	x = y = 5; // right-associative
	assert(x == 5 && y == 5);

	x += y -= 2;
	assert(x == 8 && y == 3);

	c ? a : y = 7; // c ? a : (y = 7)
	assert(a == 1 && y == 3);

	c = false;
	c ? a : y = 7;
	assert(a == 1 && y == 7);

	c = true;
	c ? a = 9 : y; // assignment in the middle operand
	assert(a == 9);

	(c ? a : y) = 11; // lvalue conditional needs parentheses
	assert(a == 11);

	x = c ? 1 : c ? 2 : 3; // right-associative
	assert(x == 1);

	if ((x = 42) == 42)
		x++;

	assert(x == 43);

	int arr[3];
	arr[1] = arr[2] = 6;
	assert(arr[1] == 6 && arr[2] == 6);
}

//..............................................................................

int main() {
	testDeclarators();
	testAssignments();
	testIfElse();
	testOptionalSemicolons();
	testPrecedence();

	printf("semicolons ok\n");
	return 0;
}

//..............................................................................
