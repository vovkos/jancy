// Ninja UI - text attributes
//

import "ui_Color.jnc"

namespace ui {

//! \addtogroup api-ui
//! @{

//..............................................................................

bitflag enum FontFlags {
	Undefined = 0x80000000, // same as ui.ColorFlags.Undefined
	Bold      = 0x00000001,
	Italic    = 0x00000002,
	Underline = 0x00000004,
	Strikeout = 0x00000008,
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct TextAttr {
	uint_t m_textColor;
	uint_t m_backColor;
	FontFlags m_fontFlags;
}

//..............................................................................

//! @}

} // namespace ui
