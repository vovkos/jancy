import "std_Buffer.jnc"
import "io_RpdFile.jnc"

namespace io {

//..............................................................................

// non-overlapping codes

enum HwcMsgCode: uint8_t {
	// generic

	Success     = 0,
	ErrorString = 1,
	Error       = 32,
	Progress    = 26,
	Tx          = 2,
	Rx          = 3,

	// hardware: serial

	// in

	SerialLineError = 33,
	SerialCtsDsr    = 34,

	// out

	SerialSetDtr    = 36,
	SerialSetRts    = 37,
	SerialSetBreak  = 38,
	SerialSetConfig = 39,
	SerialTransmit  = 40,

	// hardware: Serial Tap

	// in

	SerialTapRtsDtr    = 4,
	SerialTapCtsDsr    = 5,

	// out

	SerialTapSetConfig = 6, // HwcSerialConfig

	// FPGA-based decoders

	FpgaBufferOverflow = 7,
	FpgaUnexpectedCode = 8,
	FpgaIncompleteByte = 9,

	// hardware: I2C Tap

	// in

	I2cTapStart                = 10,
	I2cTapFinalizeStart7Bit    = 11,
	I2cTapFinalizeStart10Bit   = 12,
	I2cTapStop                 = 13,
	I2cTapStopOutOfTransaction = 14,
	I2cTapTxNack               = 15,
	I2cTapRxNack               = 16,

	// out

	I2cTapUploadFirmware       = 17,
	I2cTapStartCapture         = 18,
	I2cTapStopCapture          = 19,

	// hardware: SPI Tap

	// in

	SpiTapStart          = 20,
	SpiTapStop           = 21,
	SpiTapTxRx           = 22,

	// out

	SpiTapUploadFirmware = 23,
	SpiTapStartCapture   = 24, // HwcSpiConfig
	SpiTapStopCapture    = 25,

	// hardware: Ethernet Tap

	// in

	EthernetTapPacket_ch1     = 27, // uint32_t index, then HwcEthernetTapPacketHdr
	EthernetTapPacket_ch2     = 28, // uint32_t index, then HwcEthernetTapPacketHdr

	// out

	EthernetTapUploadFirmware = 29,
	EthernetTapStartCapture   = 30,
	EthernetTapStopCapture    = 31,

	// hardware: Serial Tap Pro

	// in

	SerialTapProRawUsbBulk        = 41, // HwcSerialTapProRawUsbBulkParams
	SerialTapProTx9               = 42,
	SerialTapProRx9               = 43,
	SerialTapProStatusLineChanged = 44, // HwcSerialTapProStatusLineChangedParams
	SerialTapProTxBreakOn         = 45,
	SerialTapProRxBreakOn         = 46,
	SerialTapProTxBreakOff        = 47,
	SerialTapProRxBreakOff        = 48,
	SerialTapProInterfaceChanged  = 49,
	SerialTapProOverflowChanged   = 50, // HwcSerialTapProOverflowChangedParams
	SerialTapProCaptureStarted    = 57, // HwcSerialTapProRawUsbBulkParams

	// out

	SerialTapProUploadFirmware       = 51,
	SerialTapProStartCapture         = 52,
	SerialTapProStopCapture          = 53,
	SerialTapProSetControl           = 54,
	SerialTapProSetRs485InjectFlags  = 55,
	SerialTapProSetNotificationDelay = 56,

	// device manager in ioninja-hwc (server tcp/pipe/rdv)

	// in

	DeviceMgrDeviceAdded   = 60, // HwcDeviceMgrDeviceParams
	DeviceMgrDeviceRemoved = 61, // HwcDeviceMgrDeviceParams

	// out

	DeviceMgrActivateDevice            = 62, // HwcDeviceMgrActivateDeviceParams
	DeviceMgrActivateDeviceByIndex     = 63, // HwcDeviceMgrActivateDeviceParams
	DeviceMgrEnumerateDevices          = 64,
	DeviceMgrEnableDeviceNotifications = 65, // bool (default: true)

	// FPGA firmware upload (all FPGA-based taps)

	// in

	FpgaVersion        = 71, // HwcFpgaVersionParams
	FpgaUploadProgress = 72, // HwcFpgaUploadProgressParams

	// out

	FpgaGetVersion   = 66,
	FpgaUploadBegin  = 67, // uint32_t total size of the .rpd file (RpdHdr included)
	FpgaUploadData   = 68, // next chunk of the .rpd file
	FpgaUploadEnd    = 69, // starts flashing
	FpgaUploadCancel = 70,
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

// mirrors ControllerKind in nj_hwc/ControllerBase.h

enum HwcControllerKind: uint16_t {
	Undefined = 0,
	DeviceMgr,
	Serial,
	SerialTap,
	I2cTap,
	SpiTap,
	EthernetTap,
	SerialTapPro,
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

// mirrors DeviceKind in nj_hwc/ControllerBase.h

enum HwcDeviceKind: uint16_t {
	Undefined = 0,
	Serial,
	SerialTap,
	I2cSpiTap, // HwcControllerKind.I2cTap & HwcControllerKind.SpiTap
	EthernetTap,
	SerialTapPro,
};

pragma(Alignment, 1)

//..............................................................................

// common header

struct HwcMsgHdr {
	char m_stx;
	HwcMsgCode m_code;
	uint16_t m_dataSize;

	// followed by msg data if any
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcSerialConfig {
	uint32_t m_baudRate;
	uint8_t m_dataBits;
	uint8_t m_stopBits;
	uint8_t m_parity;
	uint8_t m_flowControl;
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

// mirrors SpiConfig in nj_hwc/SpiConfig.h

struct HwcSpiConfig {
	uint8_t m_mode;       // 0..3
	uint8_t m_dataBits;   // 4, 8, 12, 16
	uint8_t m_endianness; // non-zero: big-endian (MSBit first)
	uint8_t _m_padding;
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

bitflag enum HwcEthernetTapPacketFlag {
	Reserved,
	CrcValid,
	BufferOverflow,
	ChannelId,
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcEthernetTapPacketHdr {
	uint16_t m_size;
	uint8_t m_reserved;
	uint8_t m_flags; // HwcEthernetTapPacketFlag
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcSerialTapProRawUsbBulkParams {
	uint16_t m_status;
	uint16_t m_lines;

	// followed by the raw notification stream
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcSerialTapProStatusLineChangedParams {
	uint16_t m_lines;
	uint16_t m_mask;
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcSerialTapProOverflowChangedParams {
	uint16_t m_overflows;
	uint16_t m_mask;
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

// DeviceMgrEnumerateDevices and the first DeviceMgrEnableDeviceNotifications
// send the full list as DeviceMgrDeviceAdded

struct HwcDeviceMgrDeviceParams {
	HwcDeviceKind m_deviceKind;
	uint8_t m_bus;
	uint8_t m_address;

	// for serial, followed by zero-terminated serial port name
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

// mirrors the subset of CmdLineFlag in nj_hwc/CmdLine.h a client may pass on activation

bitflag enum HwcCmdLineFlags: uint32_t {
	Suspend    = 0x0004, // start suspended -- capture starts on SerialTapProStartCapture etc.
	RawUsbBulk = 0x0400, // pass USB bulks as is -- the client decodes them
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcDeviceMgrActivateDeviceParams {
	HwcControllerKind m_controllerKind;

	union {
		struct {
			uint8_t m_bus;
			uint8_t m_address;
		}

		uint16_t m_index; // DeviceMgrActivateDeviceByIndex
	}

	HwcCmdLineFlags m_cmdLineFlags;

	// for serial, followed by serial port name
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

struct HwcFpgaVersionParams {
	RpdVersion m_version;
	uint16_t m_status;
};

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

enum HwcFpgaUploadStage: uint8_t {
	Erasing,
	Writing,
	Loading,
	StillWaiting,
	Completed,
};

struct HwcFpgaUploadProgressParams {
	HwcFpgaUploadStage m_stage;
	uint8_t m_percent;
};

//..............................................................................

void packHwcMsg(
	std.Buffer* buffer,
	HwcMsgCode code,
	void const* p = null,
	size_t size = 0
) {
	HwcMsgHdr hdr;
	hdr.m_stx = 0x02;
	hdr.m_code = code;
	hdr.m_dataSize = size;

	buffer.copy(&hdr, sizeof(hdr));
	buffer.append(p, size);
}

//..............................................................................

pragma(Alignment, default)

} // namespace io
