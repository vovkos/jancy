//
// Mailslot Monitor log record codes
//

import "log_RecordCode.jnc"

//..............................................................................

enum MailslotMonLogRecordCode: uint64_t {
	ServerFileOpened_0    = 0x01d4871750ac2a7b, // deprecated
	ServerFileOpenError_0 = 0x01d4871750ac2a7c, // deprecated
	ClientFileOpened_0    = 0x01d4871750ac2a7d, // deprecated
	ClientFileOpenError_0 = 0x01d4871750ac2a7e, // deprecated
	FileClosed            = 0x01d4871750ac2a7f,
	FileIdChanged_0       = 0x01d4871750ac2a80, // deprecated
	ServerFileOpened_1    = 0x01d4871750ac2a81, // deprecated
	ServerFileOpenError_1 = 0x01d4871750ac2a82, // deprecated
	ClientFileOpened_1    = 0x01d4871750ac2a83, // deprecated
	ClientFileOpenError_1 = 0x01d4871750ac2a84, // deprecated
	FileIdChanged_1       = 0x01d4871750ac2a85, // deprecated
	ServerFileOpened      = 0x01d4871750ac2a86,
	ServerFileOpenError   = 0x01d4871750ac2a87,
	ClientFileOpened      = 0x01d4871750ac2a88,
	ClientFileOpenError   = 0x01d4871750ac2a89,
	FileIdChanged         = 0x01d4871750ac2a8a,
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

enum MailslotMonLogPartCode: uint64_t {
	Prefix = 0x01d4871750ac2a85 | log.PartCodeFlags.MergeableForward,
	Suffix = 0x01d4871750ac2a85 | log.PartCodeFlags.MergeableBackward,
}

