//..............................................................................
//
// BACnet MS/TP Analyzer stream parser
//

import "log_Writer.jnc"
import "BacNetMsTpLogRecordCode.jnc"

//..............................................................................

class BacNetMsTpParser {
protected:
	jnc.DynamicLayout m_layout;
	jnc.Promise* m_promise;

public:
	void reset() {
		m_layout.clear();
		m_promise = null;
	}

	void parse(
		log.Writer* writer,
		uint64_t timestamp,
		uint64_t recordCode,
		void const* p,
		size_t size
	);
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

void BacNetMsTpParser.parse(
	log.Writer* writer,
	uint64_t timestamp,
	uint64_t recordCode,
	void const* p,
	size_t size
) {
	void const* end = p + size;
	while (p < end) { // loop to detect all packets in this block
		size = end - p;

		if (m_layout.m_isIncomplete) // continue the last incomplete packet
			size = m_layout.resume(p, size);
		else {
			// a new packet; first, locate STX...
			void const* stx = memchr(p, 0x55, size);
			if (!stx) {
				writer.write(timestamp, recordCode, p, size);
				break;
			}

			if (p < stx) { // skip the pre-STX data
				writer.write(timestamp, recordCode, p, stx - p);
				p = stx;
				size = end - stx;
			}

			// now, start laying out the new packet
			m_layout.reset(jnc.DynamicLayoutMode.Stream, null, p, size);
			m_promise = layoutBacNetMsTp(m_layout);
			if (!m_layout.m_isIncomplete)
				size = m_layout.m_size;
		}

		// write the original data first
		writer.write(timestamp, recordCode, p, size);
		p += size;

		if (m_promise.m_error) { // exception during layout
			writer.write(timestamp, BacNetMsTpLogRecordCode.ParseError, m_promise.m_error);
			reset();
			continue;
		}

		if (m_layout.m_isIncomplete) // not yet
			break;

		// the packet is successfully laid out; write it to the log after the original data
		uint64_t packetRecordCode = BacNetMsTpLogRecordCode.TxPacket + recordCode - log.StdRecordCode.Tx;
		writer.write(timestamp, packetRecordCode, m_layout.m_p, m_layout.m_size);
	}
}

//..............................................................................
