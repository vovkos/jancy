//..............................................................................
//
// Serial Tap Pro over SSH session
//

import "doc_Session.jnc"
import "io_base.jncx"
import "io_Serial.jnc"
import "io_abr.jncx"
import "iox_SshHwc.jnc"
import "ui_SshHwcUrlUi.jnc"
import "iox_HwcFpgaUploader.jnc"
import "io_HwcProto.jnc"
import "ui_SocketUi.jnc"
import "ui_SerialUi.jnc"
import "ui_SshPropertySet.jnc"
import "ui_BufferPropertySet.jnc"
import "ui_FpgaUploaderProgressDlg.jnc"
import "ui_StdSessionInfoSet.jnc"
import "ui_GroupBox.jnc"
import "log_ThroughputCalc.jnc"
import "log_ChecksumCalc.jnc"
import "std_Buffer.jnc"
import "SerialTapProLogRecordCode.jnc"
import "SerialTapProDispatchCode.jnc"
import "SerialTapProUi.jnc"

//..............................................................................

class SshSerialTapProSession:
	doc.Session,
	iox.HwcTransportSink {
protected:
	alias SshState = iox.SshChannel.State;

	enum Defaults {
		ServerPort = 22,
	}

	enum State {
		Closed,
		Connecting,          // see the transport state
		UploadingBootloader, // old firmware needs the bootloader updated first
		UploadingFirmware,   // incl. the version query & up-to-date check
		StartingCapture,     // waiting for SerialTapProCaptureStarted
		Capturing,
	}

	enum ActionId {
		Capture,
		_Count,
	}

	enum IconId {
		Capture,
		StopCapture,
		_Count,
	}

	enum StatusPaneId {
		RemoteAddress,
		State,
		_Count,
	}

protected:
	// Serial Tap Pro over SSH

	iox.SshHwc m_ssh;
	iox.HwcFpgaUploader m_uploader;
	ui.FpgaUploaderProgressDlg m_uploaderDlg;
	SerialTapProDecoder m_decoder;
	io.AutoBaudRate* m_abr[2];

	uint_t bindable m_baudRate;
	uint_t m_dataBits;
	io.SerialParity m_parity;
	io.SerialStopBits m_stopBits;

	State m_state;
	SerialTapProIface m_iface;
	SerialTapProLines m_lines;
	uint_t m_notificationDelay;

	// common serial ui

	ui.SerialUi m_serialUi;
	SerialTapProUi m_tapUi;

	// toolbar, status bar & menu

	ui.Action* m_actionTable[ActionId._Count];
	ui.Icon* m_iconTable[IconId._Count];
	ui.StatusPane* m_statusPaneTable[StatusPaneId._Count];

	// property grid

	ui.SocketPropertySet m_socketPropertySet;
	ui.SshHwcUrlUi m_urlUi;
	ui.SshPropertySet m_sshPropertySet;
	ui.BufferPropertySet m_bufferPropertySet;

	// information grid

	ui.StdSessionInfoSet m_stdSessionInfoSet;
	ui.ThroughputInfoSet m_throughputInfoSet;
	ui.ChecksumInfoSet m_checksumInfoSet;

	// ui reactor

	reactor m_uiReactor;

public:
	construct(doc.PluginHost* pluginHost);

	bool errorcode connect();
	void disconnect();

	override void load(doc.Storage* storage);
	override void save(doc.Storage* storage);
	override void updateProperties();
	override bool errorcode applyProperties();
	override void restoreDefaultProperties();

	override size_t errorcode transmit(
		void const* p,
		size_t size
	);

	override bool errorcode connectSession() {
		return m_sessionConnectionState ? true : connect();
	}

	override void disconnectSession() {
		disconnect();
	}

	override bool errorcode dispatch(
		uint_t code,
		variant_t in,
		variant_t* out
	);

protected:
	void onConnected();
	void onDisconnected();
	void onTransportStateChanged();
	void onFirmwareVersion(io.RpdVersion version);
	void onUpdateCompleted(bool result);

	override void onMsg(io.HwcMsgHdr const* hdr);

	override void onOobData(
		void const* p,
		size_t size
	) {
		m_logWriter.write(log.StdRecordCode.Bin, p, size);
	}

	void onBaudRateChanged();
	void onDataBitsChanged();
	void onParityChanged();
	void onStopBitsChanged();
	void onDtrRtsChanged();
	void onAbrChanged();
	void onInjectChanged();
	void onRs485ModeChanged();
	void onRs485ChannelChanged();

	void createUi();
	io.AutoBaudRate* constructAbr()[2];
	void startCapture();
	void stopCapture();
	bool errorcode requestCapture();

	iox.SshChannel.ConnectParams const* createConnectParams(
		string_t userName, // null = from properties
		string_t hwcArgs
	);

	bool errorcode writeMsg(
		io.HwcMsgCode code,
		void const* p = null,
		size_t size = 0
	);

	bool errorcode writeSerialConfigMsg();
	bool errorcode writeControlMsg();
	bool errorcode writeNotificationDelayMsg();
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

SshSerialTapProSession.construct(doc.PluginHost* pluginHost) {
	basetype.construct(pluginHost);
	m_ssh.construct(pluginHost);
	m_urlUi.construct(pluginHost, m_socketPropertySet, ui.SshHwcUrlUi.DeviceKind.Usb, "ioninja-hwc", "_serial-tap-pro", "Serial Tap Pro");
	m_uploader.construct(pluginHost, m_ssh);
	m_uploaderDlg.construct(m_uploader);

	m_decoder.construct(
		pluginHost.m_log.m_writer,
		pluginHost.m_txRxStats,
		m_tapUi.m_infoSet,
		constructAbr()
	);

	for (size_t i = 0; i < 2; i++)
		m_abr[i].m_onChanged += m_tapUi.m_infoSet.updateAbr~(i, m_abr[i]) @ pluginHost.m_mainThreadScheduler;

	createUi();

	m_uploader.m_onVersion += onFirmwareVersion;
	m_uploader.m_onUpdateCompleted += onUpdateCompleted;
	m_ssh.m_onLoginDlgCompleted += [](
		string_t userName,
		ui.AuthenticationMethod authenticationMethod,
		string_t privateKeyFileName
	) {
		m_sshPropertySet.m_userNameProp.m_value = userName;
		m_sshPropertySet.m_authenticationMethodProp.m_value = authenticationMethod;
		m_sshPropertySet.m_privateKeyFileProp.m_value = privateKeyFileName;
	}

	m_ssh.m_onConnected += onConnected;
	m_ssh.m_onDisconnected += onDisconnected;
	bindingof(m_ssh.m_state) += onTransportStateChanged;
	m_ssh.m_sink = this;

	pluginHost.m_log.addSelectionProcessor(log.ThroughputCalcRangeProcessor.factory~(m_throughputInfoSet));
	pluginHost.m_log.addSelectionProcessor(log.ChecksumCalcRangeProcessor.factory~(m_checksumInfoSet));
}

io.AutoBaudRate* SshSerialTapProSession.constructAbr()[2] {
	m_abr[0] = new io.AutoBaudRate;
	m_abr[1] = new io.AutoBaudRate;
	return m_abr;
}

void SshSerialTapProSession.createUi() {
	// toolbar

	m_iconTable[IconId.Capture] = new ui.Icon("images/capture.png");
	m_iconTable[IconId.StopCapture] = new ui.Icon("images/stop.png");

	m_urlUi.createToolBar("Tap:");
	m_urlUi.m_urlCombo.m_onReturnPressed += []() {
		try connect();
	}

	m_actionTable[ActionId.Capture] = createAction("Capture", m_iconTable[IconId.Capture]);
	m_actionTable[ActionId.Capture].m_onTriggered += []() {
		m_ssh.m_state ? disconnect() : try connect();
	}

	// status bar

	m_statusPaneTable[StatusPaneId.RemoteAddress] = m_pluginHost.m_statusBar.addPane(, 100);
	m_statusPaneTable[StatusPaneId.RemoteAddress].m_color = ui.StdColor.Blue;
	m_statusPaneTable[StatusPaneId.State] = m_pluginHost.m_statusBar.addPane(, 80);

	// property grid

	ui.GroupProperty* groupProp = m_pluginHost.m_propertyGrid.createGroupProperty(
		"TCP connection",
		"TCP-specific connection settings"
	);

	m_socketPropertySet.createProperties(
		m_pluginHost.m_propertyGrid,
		groupProp,,
		ui.SocketPropertySet.PropertyId.AllTcpClient & ~ui.SocketPropertySet.PropertyId.RemoteAddress // it's in the URL
	);

	m_socketPropertySet.m_defaultRemotePort = Defaults.ServerPort;

	groupProp = m_pluginHost.m_propertyGrid.createGroupProperty(
		"SSH connection",
		"SSH-specific connection settings"
	);

	m_sshPropertySet.createProperties(
		m_pluginHost.m_propertyGrid,
		groupProp,,
		ui.SshPropertySet.PropertyId.UserName |
		ui.SshPropertySet.PropertyId.AuthenticationMethod |
		ui.SshPropertySet.PropertyId.RememberLastPassword
	);

	groupProp = m_pluginHost.m_propertyGrid.createGroupProperty(
		"Serial Tap Pro",
		"Settings of the remote Serial Tap Pro"
	);

	m_urlUi.createProperties(groupProp);
	m_tapUi.createProperties(m_pluginHost.m_propertyGrid, groupProp);

	ui.SerialUi.ItemId serialUiMask =
		ui.SerialUi.ItemId.BaudRate |
		ui.SerialUi.ItemId.DataBits |
		ui.SerialUi.ItemId.StopBits |
		ui.SerialUi.ItemId.Parity |
		ui.SerialUi.ItemId.ParityIgnore;

	ui.FormLayout serialLayout;
	ui.GroupBox serialGroupBox("Serial settings", serialLayout);
	m_serialUi.createForm(serialLayout, serialUiMask);
	m_serialUi.createProperties(m_pluginHost.m_propertyGrid, groupProp, serialUiMask);
	m_serialUi.m_baudRateCombo.m_onReturnPressed += onBaudRateChanged;
	bindingof(m_serialUi.m_baudRateCombo.m_currentIndex) += onBaudRateChanged;
	bindingof(m_serialUi.m_dataBitsCombo.m_currentIndex) += onDataBitsChanged;
	bindingof(m_serialUi.m_parityCombo.m_currentIndex) += onParityChanged;
	bindingof(m_serialUi.m_stopBitsCombo.m_currentIndex) += onStopBitsChanged;

	m_tapUi.createForm(serialLayout);
	m_pluginHost.createForm(serialGroupBox);
	m_pluginHost.createForm(m_tapUi.m_injectGroupBox);

	for (size_t i = 0; i < 2; i++)
		m_tapUi.m_abrEnableCheckBoxes[i].m_onClicked += onAbrChanged;

	bindingof(m_tapUi.m_rs485ModeCombo.m_currentIndex) += onRs485ModeChanged;
	bindingof(m_tapUi.m_rs485ChannelCombo.m_currentIndex) += onRs485ChannelChanged;
	bindingof(m_tapUi.m_injectGroupBox.m_isChecked) += onInjectChanged;
	m_tapUi.m_dtrAction.m_onTriggered += onDtrRtsChanged;
	m_tapUi.m_rtsAction.m_onTriggered += onDtrRtsChanged;

	m_bufferPropertySet.createPropertiesGrouped(
		m_pluginHost.m_propertyGrid,,,
		ui.BufferPropertySet.PropertyId.All & ~ui.BufferPropertySet.PropertyId.ReadParallelism
	);

	// information grid

	ui.InformationGroup* infoGroup = m_pluginHost.m_informationGrid.createGroup("Serial Tap Pro");

	m_stdSessionInfoSet.create(m_pluginHost.m_txRxStats, m_pluginHost.m_informationGrid, infoGroup);
	m_tapUi.createInfoSet(m_pluginHost.m_informationGrid, infoGroup);

	m_throughputInfoSet.createInformationValuesGrouped(m_pluginHost.m_informationGrid);
	m_checksumInfoSet.createInformationValuesGrouped(m_pluginHost.m_informationGrid);

	m_pluginHost.m_propertyGrid.resizeNameColumnToContents();
	m_pluginHost.m_informationGrid.resizeNameColumnToContents();

	m_urlUi.enumerate();
	m_uiReactor.start();
}

bool errorcode SshSerialTapProSession.connect() {
	disconnect();
	startSession();

	m_baudRate = m_serialUi.m_baudRate;
	m_dataBits = m_serialUi.m_dataBits;
	m_stopBits = m_serialUi.m_stopBits;
	m_parity = m_serialUi.m_parity;
	m_notificationDelay = m_tapUi.m_notificationDelayProp.m_value;

	m_iface = SerialTapProIface.Undefined;
	m_lines = 0;
	iox.SshHwcUrl url;
	string_t hwcArgs;
	bool result = try m_urlUi.parseUsbUrl(&url, &hwcArgs);
	if (!result) {
		m_logWriter.writeLastError(log.StdRecordCode.Error);
		return false;
	}

	return m_ssh.connect(url.m_address, createConnectParams(url.m_userName, hwcArgs));
}

void SshSerialTapProSession.disconnect() {
	m_uploader.cancel(); // completes with false, which re-enters disconnect()
	if (!m_ssh.m_state)
		return;

	stopCapture(); // capture stopped goes before disconnected
	m_ssh.close();

	m_abr[0].close();
	m_abr[1].close();
	m_stdSessionInfoSet.endSession();
}

void SshSerialTapProSession.startCapture() {
	m_decoder.reset(m_iface, m_lines); // decoder operates on original lines
	m_tapUi.configureAbr(m_abr, m_lines); // abr operate on original lines

	SerialTapProLines lines = m_lines;
	if (m_decoder.m_isFlipped)
		lines = flipSerialTapProLines(lines);

	SerialTapProCaptureStartedParams params;
	params.m_iface = m_iface;
	params.m_baudRate = m_baudRate;
	params.m_bits.m_dataBits = m_dataBits;
	params.m_bits.m_parity = m_parity;
	params.m_bits.m_stopBits = m_stopBits;
	params.m_lines = lines;
	params.m_inject = m_tapUi.m_injectGroupBox.m_isChecked;
	params.m_rs485Mode = m_tapUi.m_rs485ModeCombo.m_currentData;
	params.m_rs485InjectChannel = m_tapUi.m_rs485ChannelCombo.m_currentIndex;
	m_logWriter.write(SerialTapProLogRecordCode.CaptureStarted, &params, sizeof(params));

	uint16_t control = m_tapUi.calcControl();
	if (control & (SerialTapProControlFlags.Edges_0 | SerialTapProControlFlags.Edges_1))
		m_logWriter.write(SerialTapProLogRecordCode.AbrChanged, &control, sizeof(control));

	m_tapUi.m_infoSet.setIface(m_iface);
	m_tapUi.m_infoSet.setOverflows(0);
	m_tapUi.m_infoSet.updateLines(lines);
	m_state = State.Capturing;
}

void SshSerialTapProSession.stopCapture() {
	if (m_state == State.Capturing)
		m_logWriter.write(SerialTapProLogRecordCode.CaptureStopped);

	m_state = State.Closed;
}

void SshSerialTapProSession.onConnected() {
	m_state = State.UploadingFirmware;

	m_stdSessionInfoSet.startSession(m_pluginHost.m_mainThreadScheduler);
	m_uploader.queryVersion();
	return;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	disconnect();
}

void SshSerialTapProSession.onFirmwareVersion(io.RpdVersion version) {
	// same as the local session: old firmware needs the bootloader updated first

	if (version.m_firmwareVersion < 0x0102) {
		m_state = State.UploadingBootloader;
		m_uploader.update(SerialTapProBootloaderFileName, true);
	} else
		m_uploader.update(SerialTapProFirmwareFileName);

	return;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	disconnect();
}

void SshSerialTapProSession.onUpdateCompleted(bool result) {
	if (!result) {
		disconnect();
		return;
	}

	if (m_state == State.UploadingBootloader) {
		m_state = State.UploadingFirmware;
		m_uploader.update(SerialTapProFirmwareFileName);
	} else
		requestCapture();

	return;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	disconnect();
}

// hwc replies with SerialTapProCaptureStarted; config changes then apply live

bool errorcode SshSerialTapProSession.requestCapture() {
	m_state = State.StartingCapture;
	m_ssh.writeMsg(io.HwcMsgCode.SerialTapProStartCapture);
	writeSerialConfigMsg();
	writeControlMsg();
	writeNotificationDelayMsg();
	return true;
}

void SshSerialTapProSession.onDisconnected() {
	m_uploader.cancel(); // completes with false, disconnect() is a no-op by now

	if (!m_ssh.m_msgCount) {
		std.setError("'ioninja-hwc' on the target machine failed to initialize");
		m_logWriter.writeLastError(log.StdRecordCode.Error);
	}

	stopCapture();
	m_abr[0].close();
	m_abr[1].close();
	m_stdSessionInfoSet.endSession();
}

// auto-reconnecting (or giving up on it) fires no session events

void SshSerialTapProSession.onTransportStateChanged() {
	if (m_state <= State.Connecting)
		m_state = m_ssh.m_state ? State.Connecting : State.Closed;
}

void SshSerialTapProSession.onMsg(io.HwcMsgHdr const* hdr) {
	switch (hdr.m_code) {
	case io.HwcMsgCode.Error:
		std.Error const* error = (std.Error const*)(hdr + 1);
		m_logWriter.write(log.StdRecordCode.Error, error, error.m_size);
		disconnect();
		break;

	case io.HwcMsgCode.ErrorString:
		std.setError((char const*)(hdr + 1));
		m_logWriter.writeLastError(log.StdRecordCode.Error);
		disconnect();
		break;

	case io.HwcMsgCode.SerialTapProCaptureStarted:
		io.HwcSerialTapProRawUsbBulkParams const* params =
			(io.HwcSerialTapProRawUsbBulkParams const*)(hdr + 1);

		m_iface = (SerialTapProIface)(params.m_status & SerialTapProIface.Mask);
		m_lines = (SerialTapProLines)params.m_lines;
		startCapture();
		break;

	case io.HwcMsgCode.SerialTapProInterfaceChanged:
		m_iface = (SerialTapProIface)*(uint8_t const*)(hdr + 1);
		m_tapUi.m_infoSet.setIface(m_iface);
		break;

	case io.HwcMsgCode.SerialTapProStatusLineChanged:
		io.HwcSerialTapProStatusLineChangedParams const* params =
			(io.HwcSerialTapProStatusLineChangedParams const*)(hdr + 1);

		m_lines = (SerialTapProLines)params.m_lines;
		m_tapUi.m_infoSet.updateLines(m_lines, (SerialTapProLines)params.m_mask);
		break;

	case io.HwcMsgCode.SerialTapProRawUsbBulk:
		if (hdr.m_dataSize < sizeof(io.HwcSerialTapProRawUsbBulkParams))
			break;

		io.HwcSerialTapProRawUsbBulkParams const* params =
			(io.HwcSerialTapProRawUsbBulkParams const*)(hdr + 1);

		m_decoder.decode(
			(char const*)(params + 1),
			hdr.m_dataSize - sizeof(io.HwcSerialTapProRawUsbBulkParams)
		);

		break;
	}
}

size_t errorcode SshSerialTapProSession.transmit(
	void const* p,
	size_t size
) {
	if (!m_isTransmitEnabled) {
		if (m_ssh.m_state != SshState.Connected)
			std.setError("Serial Tap Pro is not capturing");
		else if (!m_tapUi.m_injectGroupBox.m_isChecked)
			std.setError("Serial Tap Pro injection is disabled");

		return -1;
	}

	writeMsg(io.HwcMsgCode.SerialTransmit, p, size);

	// don't write it to log -- the tap will decode and report the injected data
	return size;
}

void SshSerialTapProSession.load(doc.Storage* storage) {
	m_urlUi.load(storage);

	m_serialUi.load(storage);
	m_tapUi.load(storage);
	m_socketPropertySet.load(storage);
	m_sshPropertySet.load(storage);
	m_bufferPropertySet.load(storage);
	m_ssh.applyProperties(m_socketPropertySet, m_sshPropertySet, m_bufferPropertySet);
}

void SshSerialTapProSession.save(doc.Storage* storage) {
	m_serialUi.save(storage);
	m_tapUi.save(storage);
	m_socketPropertySet.save(storage);
	m_sshPropertySet.save(storage);
	m_bufferPropertySet.save(storage);

	m_urlUi.save(storage);
}

void SshSerialTapProSession.updateProperties() {
	m_serialUi.updateProperties();
	m_tapUi.updateProperties();
	m_urlUi.updateProperties();
}

bool errorcode SshSerialTapProSession.applyProperties() {
	uint16_t oldControl = m_tapUi.calcControl(); // before applying the ABR properties

	m_serialUi.applyProperties();
	m_tapUi.applyProperties();

	m_urlUi.applyProperties();
	m_ssh.applyProperties(m_socketPropertySet, m_sshPropertySet, m_bufferPropertySet);

	if (m_ssh.m_state != SshState.Connected)
		return true;

	// collect new values from ui

	uint_t baudRate = m_serialUi.m_baudRate;
	uint_t dataBits = m_serialUi.m_dataBits;
	io.SerialParity parity = m_serialUi.m_parity;
	io.SerialStopBits stopBits = m_serialUi.m_stopBits;
	uint_t notificationDelay = m_tapUi.m_notificationDelayProp.m_value;

	bool isConfigChanged;

	if (baudRate != m_baudRate) {
		m_logWriter.write(SerialTapProLogRecordCode.BaudRateChanged, &baudRate, sizeof(baudRate));
		m_baudRate = baudRate;
		isConfigChanged = true;
	}

	if (dataBits != m_dataBits) {
		m_logWriter.write(SerialTapProLogRecordCode.DataBitsChanged, &dataBits, sizeof(dataBits));
		m_dataBits = dataBits;
		isConfigChanged = true;
	}

	if (parity != m_parity) {
		m_logWriter.write(SerialTapProLogRecordCode.ParityChanged, &parity, sizeof(parity));
		m_parity = parity;
		isConfigChanged = true;
	}

	if (stopBits != m_stopBits) {
		m_logWriter.write(SerialTapProLogRecordCode.StopBitsChanged, &stopBits, sizeof(stopBits));
		m_stopBits = stopBits;
		isConfigChanged = true;
	}

	if (isConfigChanged)
		writeSerialConfigMsg();

	if (notificationDelay != m_notificationDelay) {
		m_notificationDelay = notificationDelay;
		writeNotificationDelayMsg();
		m_logWriter.write(SerialTapProLogRecordCode.NotificationDelayChanged, &notificationDelay, sizeof(notificationDelay));
	}

	m_tapUi.configureAbr(m_abr, m_lines);

	uint16_t newControl = m_tapUi.calcControl();
	if (newControl != oldControl) {
		writeControlMsg();

		if ((newControl ^ oldControl) & (SerialTapProControlFlags.Edges_0 | SerialTapProControlFlags.Edges_1))
			m_logWriter.write(SerialTapProLogRecordCode.AbrChanged, &newControl, sizeof(newControl));
	}

	return true;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	return false;
}

void SshSerialTapProSession.restoreDefaultProperties() {
	m_socketPropertySet.restoreDefaults();
	m_sshPropertySet.restoreDefaults();
	m_serialUi.restoreDefaultProperties();
	m_tapUi.restoreDefaultProperties();
	m_bufferPropertySet.restoreDefaults();
}

bool errorcode SshSerialTapProSession.dispatch(
	uint_t code,
	variant_t in,
	variant_t* out
) {
	switch (code) {
	case SerialTapProDispatchCode.GetBaudRate:
		*out = m_serialUi.m_baudRate;
		break;

	case SerialTapProDispatchCode.SetBaudRate:
		m_serialUi.m_baudRate = in;
		onBaudRateChanged();
		break;

	case SerialTapProDispatchCode.GetDataBits:
		*out = m_serialUi.m_dataBits;
		break;

	case SerialTapProDispatchCode.SetDataBits:
		uint_t dataBits = in;
		m_serialUi.m_dataBits = dataBits;
		onDataBitsChanged();
		break;

	case SerialTapProDispatchCode.GetParity:
		*out = m_serialUi.m_parity;
		break;

	case SerialTapProDispatchCode.SetParity:
		io.SerialParity parity = in;
		m_serialUi.m_parity = parity;
		onParityChanged();
		break;

	case SerialTapProDispatchCode.GetStopBits:
		*out = m_serialUi.m_stopBits;
		break;

	case SerialTapProDispatchCode.SetStopBits:
		io.SerialStopBits stopBits = in;
		m_serialUi.m_stopBits = stopBits;
		onStopBitsChanged();
		break;

	case SerialTapProDispatchCode.GetStatusLines:
	case SerialTapProDispatchCode.GetDtr:
	case SerialTapProDispatchCode.GetRts:
		// not yet
		break;

	case SerialTapProDispatchCode.Capture:
		return connect();

	case SerialTapProDispatchCode.StopCapture:
		disconnect();
		break;

	case SerialTapProInternalDispatchCode.Flip:
		m_decoder.flip(in);
		break;

	default:
		std.setError("unsupported dispatch code");
		return false;
	}

	return true;
}

void SshSerialTapProSession.onBaudRateChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	uint_t baudRate = m_serialUi.m_baudRate;
	if (baudRate == m_baudRate)
		return;

	m_logWriter.write(SerialTapProLogRecordCode.BaudRateChanged, &baudRate, sizeof(baudRate));
	m_baudRate = baudRate;
	writeSerialConfigMsg();

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onDataBitsChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	uint_t dataBits = m_serialUi.m_dataBits;
	if (dataBits == m_dataBits)
		return;

	m_logWriter.write(SerialTapProLogRecordCode.DataBitsChanged, &dataBits, sizeof(dataBits));
	m_dataBits = dataBits;
	writeSerialConfigMsg();

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onParityChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	io.SerialParity parity = m_serialUi.m_parity;
	if (parity == m_parity)
		return;

	m_logWriter.write(SerialTapProLogRecordCode.ParityChanged, &parity, sizeof(parity));
	m_parity = parity;
	writeSerialConfigMsg();

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onStopBitsChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	io.SerialStopBits stopBits = m_serialUi.m_stopBits;
	if (stopBits == m_stopBits)
		return;

	m_logWriter.write(SerialTapProLogRecordCode.StopBitsChanged, &stopBits, sizeof(stopBits));
	m_stopBits = stopBits;
	writeSerialConfigMsg();

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onDtrRtsChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	writeControlMsg();

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onAbrChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	m_tapUi.configureAbr(m_abr, m_lines);

	uint16_t control = m_tapUi.calcControl();
	writeControlMsg();
	m_logWriter.write(SerialTapProLogRecordCode.AbrChanged, &control, sizeof(control));

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onInjectChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	writeControlMsg();

	SerialTapProInjectChangedParams params;
	params.m_inject = m_tapUi.m_injectGroupBox.m_isChecked;
	if (params.m_inject) {
		params.m_rs485 = m_decoder.m_serialIface == SerialTapProIface.Rs485;
		params.m_rs485Mode = m_tapUi.m_rs485ModeCombo.m_currentData;
		params.m_rs485InjectChannel = m_tapUi.m_rs485ChannelCombo.m_currentIndex;
	}

	m_logWriter.write(SerialTapProLogRecordCode.InjectChanged, &params, sizeof(params));

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onRs485ModeChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	writeControlMsg();

	SerialTapProRs485Mode mode = m_tapUi.m_rs485ModeCombo.m_currentData;
	m_logWriter.write(SerialTapProLogRecordCode.Rs485InjectModeChanged, &mode, sizeof(mode));

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

void SshSerialTapProSession.onRs485ChannelChanged() {
	if (m_ssh.m_state != SshState.Connected)
		return;

	writeControlMsg();

	uint8_t channel = m_tapUi.m_rs485ChannelCombo.m_currentIndex;
	m_logWriter.write(SerialTapProLogRecordCode.Rs485InjectChannelChanged, &channel, sizeof(channel));

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
}

iox.SshChannel.ConnectParams const* SshSerialTapProSession.createConnectParams(
	string_t userName,
	string_t hwcArgs
) {
	static string_t const stopBitsStringTable[] = {
		"1",
		"1.5",
		"2",
	}

	static string_t const parityStringTable[] = {
		"none",
		"odd",
		"even",
		"mark",
		"space",
	}

	string_t cmdLine =
		$"ioninja-hwc --stdin --serial-tap-pro --raw-usb-bulk --suspend$hwcArgs " // the firmware may need an update first
		$"--ser-baud %1 "
		$"--ser-data %2 "
		$"--ser-stop %3 "
		$"--ser-parity %4 "(
			m_baudRate,
			m_dataBits,
			stopBitsStringTable[m_stopBits],
			parityStringTable[m_parity]
		);

	iox.SshChannel.ConnectParams params;
	iox.SshChannel.initConnectParams(&params, m_socketPropertySet, m_sshPropertySet, m_bufferPropertySet);
	params.m_sshParams.m_channelType = "session";
	params.m_sshParams.m_processType = "exec";
	params.m_sshParams.m_processExtra = cmdLine.m_p;
	params.m_sshParams.m_processExtraSize = cmdLine.m_length;

	if (userName)
		params.m_sshParams.m_userName = userName;

	return params;
}

bool errorcode SshSerialTapProSession.writeMsg(
	io.HwcMsgCode code,
	void const* p,
	size_t size
) {
	return m_ssh.writeMsg(code, p, size);
}

bool errorcode SshSerialTapProSession.writeSerialConfigMsg() {
	io.HwcSerialConfig config;
	config.m_baudRate = m_baudRate;
	config.m_dataBits = m_dataBits;
	config.m_stopBits = m_stopBits;
	config.m_parity = m_parity;
	config.m_flowControl = false;
	return writeMsg(io.HwcMsgCode.SerialTapSetConfig, &config, sizeof(config));
}

bool errorcode SshSerialTapProSession.writeControlMsg() {
	uint16_t control = m_tapUi.calcControl();
	return writeMsg(io.HwcMsgCode.SerialTapProSetControl, &control, sizeof(control));
}

bool errorcode SshSerialTapProSession.writeNotificationDelayMsg() {
	uint32_t delay = m_notificationDelay;
	return writeMsg(io.HwcMsgCode.SerialTapProSetNotificationDelay, &delay, sizeof(delay));
}

reactor SshSerialTapProSession.m_uiReactor {
	m_title = m_ssh.m_state == SshState.Connected ?
		$"Serial Tap Pro $(m_ssh.m_remoteAddress.getString()) $m_baudRate bps" :
		$"Serial Tap Pro $(m_urlUi.m_displayUrl) $(m_serialUi.m_baudRateCombo.m_editText)";

	m_sessionConnectionState =
		m_ssh.m_state == SshState.Connected ? SessionConnectionState.Connected :
		m_ssh.m_state == SshState.Closed ? SessionConnectionState.Disconnected :
		SessionConnectionState.Connecting;

	m_actionTable[ActionId.Capture].m_text = m_ssh.m_state ? "Stop capture" : "Capture";
	m_actionTable[ActionId.Capture].m_icon = m_iconTable[m_ssh.m_state ? IconId.StopCapture : IconId.Capture];
	m_statusPaneTable[StatusPaneId.State].m_text = m_ssh.m_stateStringTable[m_ssh.m_state];
	m_statusPaneTable[StatusPaneId.RemoteAddress].m_text = m_ssh.m_state > SshState.Resolving ?
		m_ssh.m_remoteAddress.getString() :
		"<peer-address>";
	m_statusPaneTable[StatusPaneId.RemoteAddress].m_isVisible = m_ssh.m_state > SshState.Resolving;

	m_tapUi.m_dtrAction.m_isEnabled =
	m_tapUi.m_rtsAction.m_isEnabled =
		m_tapUi.m_injectGroupBox.m_isChecked &&
		m_ssh.m_state == SshState.Connected &&
		m_decoder.m_serialIface != SerialTapProIface.Rs485;

	m_tapUi.m_rs485ModeCombo.m_isEnabled =
	m_tapUi.m_rs485ChannelCombo.m_isEnabled =
		m_tapUi.m_injectGroupBox.m_isChecked &&
		m_ssh.m_state == SshState.Connected &&
		m_decoder.m_serialIface == SerialTapProIface.Rs485;

	m_tapUi.m_infoSet.enable(
		m_ssh.m_state == SshState.Connected,
		m_tapUi.m_abrEnableCheckBoxes[0].m_isChecked,
		m_tapUi.m_abrEnableCheckBoxes[1].m_isChecked
	);

	m_tapUi.m_abrBaudRateGridCellCountProp.m_isEnabled = !m_tapUi.m_abrStdBaudRateOnlyProp.m_value;

	m_isTransmitEnabled =
		m_ssh.m_state == SshState.Connected &&
		m_tapUi.m_injectGroupBox.m_isChecked;
}

