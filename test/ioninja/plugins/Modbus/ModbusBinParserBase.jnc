//..............................................................................
//
// Modbus binary stream parser base class
//

//..............................................................................

class ModbusBinParserBase: ModbusParserBase {
protected:
	jnc.DynamicLayout m_layout;
	jnc.Promise* m_promise;

public:
	construct(
		io.ModbusProtocol readonly protocol,
		ModbusInfoSet* infoSet
	) {
		basetype.construct(protocol, infoSet);
	}

	override void reset();

	override void parse(
		log.Writer* writer,
		uint64_t timestamp,
		uint64_t originalRecordCode,
		void const* p,
		size_t size
	);

protected:
	virtual void preParse(
		log.Writer* writer,
		uint64_t timestamp
	) {}

	virtual void postPacket() {}

	abstract jnc.Promise* layoutPacket();
	abstract uint64_t getPacketRecordCode();
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

override void ModbusBinParserBase.reset() {
	basetype.reset();
	m_layout.clear();
	m_promise = null;
}

void ModbusBinParserBase.parse(
	log.Writer* writer,
	uint64_t timestamp,
	uint64_t originalRecordCode,
	void const* p,
	size_t size
) {
	preParse(writer, timestamp);

	void const* end = p + size;
	while (p < end) {
		size = end - p;

		if (m_layout.m_isIncomplete) // resume the incomplete packet
			size = m_layout.resume(p, size);
		else { // start a new one
			m_layout.reset(jnc.DynamicLayoutMode.Stream, null, p, size);
			m_promise = layoutPacket();
			if (!m_layout.m_isIncomplete)
				size = m_layout.m_size;
		}

		writer.write(timestamp, originalRecordCode, p, size);
		p += size;

		if (m_promise.m_error) { // exception during layout
			writer.write(timestamp, ModbusLogRecordCode.ParseError, m_promise.m_error);
			m_infoSet.addError();
			reset();
			continue;
		}

		if (m_layout.m_isIncomplete)
			break;

		writer.write(timestamp, getPacketRecordCode(), m_layout.m_p, m_layout.m_size);
		m_infoSet.addAdu(m_modbusRole);
		postPacket();
	}
}

//..............................................................................
