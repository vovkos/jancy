//..............................................................................
//
// I2C/SPI Tap over rendezvous session
//

import "doc_Session.jnc"
import "iox_RendezvousHwc.jnc"
import "iox_HwcFpgaUploader.jnc"
import "io_HwcProto.jnc"
import "ui_SocketUi.jnc"
import "ui_RendezvousHwcUi.jnc"
import "ui_FpgaUploaderProgressDlg.jnc"
import "ui_BufferPropertySet.jnc"
import "ui_StdSessionInfoSet.jnc"
import "log_ThroughputCalc.jnc"
import "log_ChecksumCalc.jnc"
import "std_Buffer.jnc"
import "I2cSpiTapLogRecordCode.jnc"
import "I2cSpiTapHwc.jnc"

//..............................................................................

class RdvI2cSpiTapSession:
	doc.Session,
	iox.HwcTransportSink {
protected:
	alias RdvState = iox.Rendezvous.State;
	alias Protocol = I2cSpiTapHwcUi.Protocol;

	enum State {
		Closed,
		Connecting,        // see the transport state
		UploadingFirmware, // incl. the up-to-date check
		Capturing,
	}

	enum ActionId {
		Capture,
		_Count,
	}

	enum IconId {
		Capture,
		StopCapture,
		_Count,
	}

	enum StatusPaneId {
		RemoteAddress,
		State,
		_Count,
	}

protected:
	// I2C/SPI Tap over rendezvous

	iox.RendezvousHwc m_rdv;
	ui.RendezvousHwcUi m_rdvUi;
	iox.RendezvousHwcDevice* m_device;
	iox.HwcFpgaUploader m_uploader;
	ui.FpgaUploaderProgressDlg m_uploaderDlg;
	Protocol m_protocol;
	std.Buffer m_startCaptureMsg; // to restart on SPI config changes
	State m_state;

	// toolbar, status bar & menu

	ui.Action* m_actionTable[ActionId._Count];
	ui.Icon* m_iconTable[IconId._Count];
	ui.StatusPane* m_statusPaneTable[StatusPaneId._Count];

	// property grid

	ui.SocketPropertySet m_socketPropertySet;
	I2cSpiTapHwcUi m_tapUi;
	ui.BufferPropertySet m_bufferPropertySet;

	// information grid

	ui.StdSessionInfoSet m_stdSessionInfoSet;
	ui.ThroughputInfoSet m_throughputInfoSet;
	ui.ChecksumInfoSet m_checksumInfoSet;

	// ui reactor

	reactor m_uiReactor;

public:
	construct(doc.PluginHost* pluginHost);

	bool errorcode connect();
	void disconnect();

	override void load(doc.Storage* storage);
	override void save(doc.Storage* storage);
	override void updateProperties();
	override errorcode bool applyProperties();
	override void restoreDefaultProperties();

	override bool errorcode connectSession() {
		return m_sessionConnectionState ? true : connect();
	}

	override void disconnectSession() {
		disconnect();
	}

protected:
	void onProtocolChanged();
	void onConnected();
	void onDisconnected();
	void onTransportStateChanged();
	void onUpdateCompleted(bool result);

	override void onMsg(io.HwcMsgHdr const* hdr);

	override void onOobData(
		void const* p,
		size_t size
	) {
		m_logWriter.write(log.StdRecordCode.Bin, p, size);
	}

	void createUi();
	bool errorcode startCapture();
	void stopCapture();
	bool errorcode restartSpiCapture();

	iox.Rendezvous.ConnectParams const* createConnectParams();
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

RdvI2cSpiTapSession.construct(doc.PluginHost* pluginHost) {
	basetype.construct(pluginHost);
	m_rdv.construct(pluginHost);
	m_rdvUi.construct(pluginHost, io.RendezvousHwcPeripheralKind.I2cSpiTap, "I2C/SPI Tap");
	m_tapUi.construct(pluginHost);
	m_uploader.construct(pluginHost, m_rdv);
	m_uploaderDlg.construct(m_uploader);

	createUi();

	m_uploader.m_onUpdateCompleted += onUpdateCompleted;
	m_rdv.m_onConnected += onConnected;
	m_rdv.m_onDisconnected += onDisconnected;
	bindingof(m_rdv.m_state) += onTransportStateChanged;
	m_rdv.m_sink = this;

	pluginHost.m_log.addSelectionProcessor(log.ThroughputCalcRangeProcessor.factory~(m_throughputInfoSet));
	pluginHost.m_log.addSelectionProcessor(log.ChecksumCalcRangeProcessor.factory~(m_checksumInfoSet));
}

void RdvI2cSpiTapSession.createUi() {
	// toolbar

	m_iconTable[IconId.Capture] = new ui.Icon("images/capture.png");
	m_iconTable[IconId.StopCapture] = new ui.Icon("images/stop.png");

	m_rdvUi.createToolBar("Tap:");
	m_rdvUi.m_deviceCombo.m_onReturnPressed += []() {
		try connect();
	}

	m_tapUi.createToolBar();
	bindingof(m_tapUi.m_protocolCombo.m_currentIndex) += onProtocolChanged;

	m_actionTable[ActionId.Capture] = createAction("Capture", m_iconTable[IconId.Capture]);
	m_actionTable[ActionId.Capture].m_onTriggered += []() {
		m_rdv.m_state ? disconnect() : try connect();
	}

	m_tapUi.createFlipAction();

	// status bar

	m_statusPaneTable[StatusPaneId.RemoteAddress] = m_pluginHost.m_statusBar.addPane(, 100);
	m_statusPaneTable[StatusPaneId.RemoteAddress].m_color = ui.StdColor.Blue;
	m_statusPaneTable[StatusPaneId.State] = m_pluginHost.m_statusBar.addPane(, 80);

	// property grid

	ui.GroupProperty* group = m_pluginHost.m_propertyGrid.createGroupProperty(
		"Rendezvous connection",
		"Rendezvous-specific connection settings"
	);

	m_rdvUi.createProperties(group);

	m_socketPropertySet.createProperties(
		m_pluginHost.m_propertyGrid,
		group,,
		ui.SocketPropertySet.PropertyId.Reconnect
	);

	group = m_pluginHost.m_propertyGrid.createGroupProperty(
		"I2C/SPI Tap",
		"Settings of the remote I2C/SPI Tap"
	);

	m_tapUi.createProperties(group);

	m_bufferPropertySet.createPropertiesGrouped(
		m_pluginHost.m_propertyGrid,,,
		ui.BufferPropertySet.PropertyId.All & ~ui.BufferPropertySet.PropertyId.ReadParallelism
	);

	// information grid

	ui.InformationGroup* infoGroup = m_pluginHost.m_informationGrid.createGroup("I2C/SPI Tap");

	m_stdSessionInfoSet.create(m_pluginHost.m_txRxStats, m_pluginHost.m_informationGrid, infoGroup);
	m_throughputInfoSet.createInformationValuesGrouped(m_pluginHost.m_informationGrid);
	m_checksumInfoSet.createInformationValuesGrouped(m_pluginHost.m_informationGrid);

	m_pluginHost.m_propertyGrid.resizeNameColumnToContents();
	m_pluginHost.m_informationGrid.resizeNameColumnToContents();

	m_rdvUi.enumerate();
	m_uiReactor.start();
}

bool errorcode RdvI2cSpiTapSession.connect() {
	iox.RendezvousHwcDevice* device = m_rdvUi.m_device;
	if (!device) {
		std.setError("no remote I2C/SPI Tap selected");
		return false;
	}

	disconnect();
	startSession();

	m_device = device;
	m_protocol = m_tapUi.m_protocol;
	return m_rdv.connect(m_rdvUi.getServerUrl(device.m_path), createConnectParams());
}

void RdvI2cSpiTapSession.disconnect() {
	m_uploader.cancel(); // completes with false, which re-enters disconnect()
	if (!m_rdv.m_state)
		return;

	stopCapture(); // capture stopped goes before disconnected
	m_rdv.close();
	m_stdSessionInfoSet.endSession();
}

void RdvI2cSpiTapSession.stopCapture() {
	if (m_state == State.Capturing)
		m_logWriter.write(I2cSpiTapLogRecordCode.CaptureStopped);

	m_state = State.Closed;
}

iox.Rendezvous.ConnectParams const* RdvI2cSpiTapSession.createConnectParams() {
	iox.Rendezvous.ConnectParams params;

	iox.Rendezvous.initConnectParams(
		&params,
		m_socketPropertySet,
		m_bufferPropertySet,
		m_rdvUi.m_keyFileProp.m_value
	);

	return params;
}

void RdvI2cSpiTapSession.load(doc.Storage* storage) {
	m_tapUi.load(storage);
	m_socketPropertySet.load(storage);
	m_bufferPropertySet.load(storage);
	m_rdv.applyProperties(m_socketPropertySet, m_bufferPropertySet);
	m_rdvUi.load(storage);
}

void RdvI2cSpiTapSession.save(doc.Storage* storage) {
	m_tapUi.save(storage);
	m_socketPropertySet.save(storage);
	m_bufferPropertySet.save(storage);
	m_rdvUi.save(storage);
}

void RdvI2cSpiTapSession.updateProperties() {
	m_tapUi.updateProperties();
	m_rdvUi.updateProperties();
}

bool errorcode RdvI2cSpiTapSession.applyProperties() {
	m_tapUi.applyProperties(); // may change the protocol and reconnect
	m_rdv.applyProperties(m_socketPropertySet, m_bufferPropertySet);
	m_rdvUi.applyProperties();

	if (m_state == State.Capturing && m_protocol == Protocol.Spi)
		restartSpiCapture();

	return true;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	return false;
}

void RdvI2cSpiTapSession.restoreDefaultProperties() {
	m_tapUi.restoreDefaults();
	m_socketPropertySet.restoreDefaults();
	m_bufferPropertySet.restoreDefaults();
	m_rdvUi.restoreDefaults();
}

// the tap controller is chosen on activation -- a new protocol needs a new session

void RdvI2cSpiTapSession.onProtocolChanged() {
	if (m_rdv.m_state && m_tapUi.m_protocol != m_protocol)
		try connect();
}

bool errorcode RdvI2cSpiTapSession.restartSpiCapture() {
	std.Buffer msg;
	m_tapUi.packStartCaptureMsg(msg);
	if (msg.m_size == m_startCaptureMsg.m_size && !memcmp(msg.m_p, m_startCaptureMsg.m_p, msg.m_size))
		return true;

	m_startCaptureMsg.copy(msg.m_p, msg.m_size);
	m_rdv.write(msg.m_p, msg.m_size);
	m_logWriter.write(I2cSpiTapLogRecordCode.CaptureStarted);
	return true;
}

void RdvI2cSpiTapSession.onConnected() {
	m_state = State.UploadingFirmware;

	// activate suspended: the firmware may need an update before capturing

	m_rdv.writeActivateDeviceMsg(m_device, m_tapUi.getControllerKind(), io.HwcCmdLineFlags.Suspend);
	m_stdSessionInfoSet.startSession(m_pluginHost.m_mainThreadScheduler);
	m_uploader.update(m_tapUi.getFirmwareFileName());
	return;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	disconnect();
}

void RdvI2cSpiTapSession.onUpdateCompleted(bool result) {
	if (!result) {
		disconnect();
		return;
	}

	startCapture();
	return;

catch:
	m_logWriter.writeLastError(log.StdRecordCode.Error);
	disconnect();
}

bool errorcode RdvI2cSpiTapSession.startCapture() {
	m_tapUi.packStartCaptureMsg(m_startCaptureMsg);
	m_rdv.write(m_startCaptureMsg.m_p, m_startCaptureMsg.m_size);
	m_logWriter.write(I2cSpiTapLogRecordCode.CaptureStarted);
	m_state = State.Capturing;
	return true;
}

void RdvI2cSpiTapSession.onDisconnected() {
	m_uploader.cancel(); // completes with false, disconnect() is a no-op by now

	if (!m_rdv.m_msgCount) {
		std.setError("'ioninja-hwc' on the target machine failed to initialize");
		m_logWriter.writeLastError(log.StdRecordCode.Error);
	}

	stopCapture();
	m_stdSessionInfoSet.endSession();
}

// auto-reconnecting (or giving up on it) fires no session events

void RdvI2cSpiTapSession.onTransportStateChanged() {
	if (m_state <= State.Connecting)
		m_state = m_rdv.m_state ? State.Connecting : State.Closed;
}

void RdvI2cSpiTapSession.onMsg(io.HwcMsgHdr const* hdr) {
	switch (hdr.m_code) {
	case io.HwcMsgCode.Error:
		std.Error const* error = (std.Error const*)(hdr + 1);
		m_logWriter.write(log.StdRecordCode.Error, error, error.m_size);
		disconnect();
		break;

	case io.HwcMsgCode.ErrorString:
		std.setError((char const*)(hdr + 1));
		m_logWriter.writeLastError(log.StdRecordCode.Error);
		disconnect();
		break;

	default:
		m_tapUi.writeLog(m_logWriter, hdr);
	}
}

reactor RdvI2cSpiTapSession.m_uiReactor {
	m_title = m_rdv.m_state == RdvState.Connected ?
		$"$(m_tapUi.m_protocolCombo.m_currentText) $(m_device.m_text)" :
		$"$(m_tapUi.m_protocolCombo.m_currentText) $(m_rdvUi.m_deviceCombo.m_currentText)";

	m_sessionConnectionState =
		m_rdv.m_state == RdvState.Connected ? SessionConnectionState.Connected :
		m_rdv.m_state == RdvState.Closed ? SessionConnectionState.Disconnected :
		SessionConnectionState.Connecting;

	m_actionTable[ActionId.Capture].m_text = m_rdv.m_state ? "Stop capture" : "Capture";
	m_actionTable[ActionId.Capture].m_icon = m_iconTable[m_rdv.m_state ? IconId.StopCapture : IconId.Capture];
	m_statusPaneTable[StatusPaneId.State].m_text = m_rdv.m_stateStringTable[m_rdv.m_state];
	m_statusPaneTable[StatusPaneId.RemoteAddress].m_text = m_rdv.m_state ? m_rdv.m_url : "<tap-url>";
	m_statusPaneTable[StatusPaneId.RemoteAddress].m_isVisible = m_rdv.m_state != RdvState.Closed;
}

