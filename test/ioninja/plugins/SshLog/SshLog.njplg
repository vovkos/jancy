[plugin]

name        = SSH Log
description = "SSH log representer"
group       = net
guid        = 8ec96e77-89df-4dd8-bc14-b995b85de45d
icon        = images/ssh.png
small-icon  = images/ssh-16x16.png

log-representer-func = representSshLog

[scripts]

SshLogRecordCode.jnc
SshLogRepresenter.jnc

[records]

01d4840c424a4d00  # Handshaking
01d4840c424a4d01  # Authenticating
01d4840c424a4d02  # Reauthenticating
01d4840c424a4d03  # OpeningChannel
01d4840c424a4d04  # RequestingPty
01d4840c424a4d05  # StartingProcess
01d4840c424a4d06  # LastStepCompleted
01d4840c424a4d07  # ChannelEstablished
01d4840c424a4d09  # Reconnecting
