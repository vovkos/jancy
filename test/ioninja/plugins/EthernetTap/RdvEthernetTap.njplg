#...............................................................................
#
#  Ethernet Tap over rendezvous session plugin
#

[plugin]

name        = "Ethernet Tap over RDV"
description = "Monitor Ethernet packets via an Ethernet Tap connected to a remote machine reachable over the IO Ninja rendezvous relay"
id          = rdv-ethernet-tap
group       = hw
monitor     = true
terminal    = false
log-guid    = ae3dc2da-6124-4c14-b05a-200df2fc580a  # ethernet tap
log-guid    = b26c1b57-16c7-48a5-bbb9-05ea1ada5368  # fpga uploader
log-guid    = db8c8923-a699-46cc-be7c-f0bcd523082b  # socket
log-guid    = e44cf2e3-53c6-4484-8b32-4931a1df0f8a  # rendezvous
log-guid    = 7940a0d5-a84b-4509-bae4-b5928511472d  # ssl
icon        = images/sniffer.png
small-icon  = images/sniffer-16x16.png

session-class = RdvEthernetTapSession

[required-capabilities]

org.jancy.io.net

[optional-capabilities]

org.jancy.io.ip4
org.jancy.io.ip6
org.jancy.io.file

[scripts]

EthernetTap.jnc
RdvEthernetTapSession.jnc
