import "jnc_DynamicLayout.jnc"

namespace jnc {

//! \addtogroup rtl-dylayout
//! @{

//..............................................................................

opaque class DynamicLayoutSectionGroup {
	size_t readonly m_sectionCount;
	DynamicLayoutSection* const property m_sectionArray(size_t index);

	construct();
	destruct();
}

//..............................................................................

enum DynamicLayoutSectionKind {
	Undefined,
	Struct,    // all regular fields are packed into structs
	Array,     // a non-const-sized array can't be part of a struct
	Field,     // a bitfield or a field with dynamic attributes
	Group,     // for grouping
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

opaque class DynamicLayoutSection: DynamicLayoutSectionGroup {
	DynamicLayoutSectionKind readonly m_sectionKind;
	size_t readonly m_offset;
	size_t readonly m_size;

	ModuleItemDecl* const property m_decl; // null for DynamicLayoutSectionKind.Struct
	Type* const property m_type;           // null for DynamicLayoutSectionKind.Group

	union {
		size_t readonly m_elementCount;    // for DynamicLayoutSectionKind.Array
		struct {                           // for DynamicLayoutSectionKind.Field
			uint_t readonly m_bitOffset;
			uint_t readonly m_bitCount;
		}
	}

	PtrTypeFlags readonly m_ptrTypeFlags;  // for DynamicLayoutSectionKind.Array & Field

	destruct();
}

//..............................................................................

opaque class DynamicLayoutSectionBuilder: DynamicLayoutSink {
	DynamicLayoutSectionGroup const* readonly m_sectionGroup;

	construct();
	destruct();

	void reset();

	override void onStruct(
		StructType* structType,
		size_t offset,
		void const* p
	);

	override void onArray(
		ModuleItemDecl* decl,
		Type* type,
		size_t elementCount,
		PtrTypeFlags ptrTypeFlags,
		size_t offset,
		void const* p
	);

	override void onField(
		ModuleItemDecl* decl,
		Type* type,
		PtrTypeFlags ptrTypeFlags,
		size_t offset,
		void const* p
	);

	override void onBitField(
		ModuleItemDecl* decl,
		Type* type,
		uint_t bitOffset,
		uint_t bitCount,
		PtrTypeFlags ptrTypeFlags,
		size_t offset,
		void const* p
	);

	override void onGroupOpened(
		ModuleItemDecl* decl,
		size_t offset
	);

	override void onGroupClosed(
		ModuleItemDecl* decl,
		size_t offset,
		void const* p,
		size_t size
	);
}

//..............................................................................

//! @}

} // namespace jnc
