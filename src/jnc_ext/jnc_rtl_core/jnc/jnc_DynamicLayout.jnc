import "std_Buffer.jnc"

namespace jnc {

//! \addtogroup rtl-dylayout
//! @{

//..............................................................................

// the sink is notified of data sections once their bytes are available, and of
// groups on open and on close. p is only valid during the call (stream buffer may move)

class DynamicLayoutSink {
	virtual void onStruct(
		StructType* structType,
		size_t offset,
		void const* p
	) {}

	virtual void onArray(
		ModuleItemDecl* decl,
		Type* type,
		size_t elementCount,
		PtrTypeFlags ptrTypeFlags,
		size_t offset,
		void const* p
	) {}

	virtual void onField(
		ModuleItemDecl* decl,
		Type* type,
		PtrTypeFlags ptrTypeFlags,
		size_t offset,
		void const* p
	) {}

	virtual void onBitField(
		ModuleItemDecl* decl,
		Type* type,
		uint_t bitOffset,
		uint_t bitCount,
		PtrTypeFlags ptrTypeFlags,
		size_t offset,
		void const* p
	) {}

	virtual void onGroupOpened(
		ModuleItemDecl* decl,
		size_t offset // we don't know the group size at this point
	) {}

	virtual void onGroupClosed(
		ModuleItemDecl* decl, // same as onGroupOpened's decl
		size_t offset,        // same as onGroupOpened's offset
		void const* p,
		size_t size
	) {}
}

//..............................................................................

enum DynamicLayoutMode {
	Block,  // data block is available in one piece (default)
	Stream, // incremental parsing (dylayout must be in an async function)
	Default = Block
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

enum DynamicLayoutAwaitKind {
	None, // not awaiting
	Size, // awaiting (m_size - m_bufferSize) more bytes
	Char, // awaiting m_awaitChar (scanning since m_size)
}

// . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . .

opaque class DynamicLayout {
protected:
	// only for DynamicLayoutMode.Stream

	std.Buffer m_buffer;
	Promise* m_auxPromise; // to avoid extra allocations

public:
	DynamicLayoutSink* readonly m_sink;
	Promise const* readonly m_promise;  // when async-waiting for resume()
	void const* readonly m_p;
	size_t readonly m_size;       // layout size (can be larger than buffer size)
	size_t readonly m_bufferSize; // size of the buffer being parsed
	size_t m_sizeLimit;           // freely adjustible (affects addStruct and addArray)

	DynamicLayoutMode readonly m_mode;

	// only for DynamicLayoutMode.Stream

	DynamicLayoutAwaitKind readonly m_awaitKind;
	char readonly m_awaitChar;

	bool const property m_isIncomplete {
		return m_size > m_bufferSize;
	}

	void const* const property m_end {
		return m_p + m_size;
	}

	construct() {
		init();
	}

	construct(
		DynamicLayoutMode mode,
		DynamicLayoutSink* sink,
		void const* p,
		size_t size
	) {
		init();
		reset(mode, sink, p, size);
	}

	construct(
		DynamicLayoutSink* sink,
		void const* p,
		size_t size
	) {
		init();
		reset(DynamicLayoutMode.Default, sink, p, size);
	}

	destruct();

	void clear() {
		reset(DynamicLayoutMode.Default, null, null, 0);
	}

	void reset(
		DynamicLayoutMode mode,
		DynamicLayoutSink* sink,
		void const* p,
		size_t size
	);

	void reset(
		DynamicLayoutSink* sink,
		void const* p,
		size_t size
	) {
		reset(DynamicLayoutMode.Default, sink, p, size);
	}

	// notify the sink about all groups which are still open (e.g. after an exception)

	void closeAllGroups();

	// only for DynamicLayoutMode.Stream

	size_t resume(
		void const* p,
		size_t size
	);

	// suspend async stream layout until we see the delimiter (e.g., a string null-terminator)

	async size_t asyncScanTo(char c);

	async size_t asyncStrlen() {
		return await asyncScanTo(0);
	}

protected:
	void init();

	bool const property m_shouldAwait {
		return m_mode == DynamicLayoutMode.Stream && m_isIncomplete;
	}

	size_t errorcode addStruct(
		void thin* structType,
		bool isAsync
	);

	size_t errorcode addArray(
		void thin* decl,
		variant_t const thin* dynamicAttrArray,
		size_t dynamicAttrCount,
		void thin* type,
		size_t elementCount,
		uint_t ptrTypeFlags,
		bool isAsync
	);

	size_t errorcode addField(
		void thin* decl,
		variant_t const thin* dynamicAttrArray,
		size_t dynamicAttrCount,
		void thin* type,
		uint_t ptrTypeFlags,
		bool isAsync
	);

	// addBitField -> uint64_t:
	//     higher 56-bits - byte offset
	//     lower 8-bits - bit offset

	uint64_t errorcode addBitField(
		void thin* decl,
		variant_t const thin* dynamicAttrArray,
		size_t dynamicAttrCount,
		void thin* type,
		uint_t bitCount,
		uint_t ptrTypeFlags,
		bool isAsync
	);

	size_t openGroup(
		void thin* decl,
		variant_t const thin* dynamicAttrArray,
		size_t dynamicAttrCount
	);

	void closeGroup();
	void closeGroups(size_t count);
}

//! @}

} // namespace jnc
